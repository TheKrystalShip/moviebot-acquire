<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Records plus a source-generated JSON context, matching Core: the indexer contract stays
         usable from a trimmed or AOT consumer. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <RootNamespace>TheKrystalShip.MovieBot.Acquire</RootNamespace>
    <AssemblyName>TheKrystalShip.MovieBot.Acquire</AssemblyName>
    <Version>0.18.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

</Project>
